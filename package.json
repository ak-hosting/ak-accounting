{
  "name": "ak-accounting",
  "version": "2.0.0",
  "private": true,
  "description": "Mali müşavirlik ofisleri için bağımsız, erişilebilir GitHub Pages şablonu",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "dev": "python3 -m http.server 8000",
    "build": "node scripts/validate.mjs",
    "test": "node scripts/validate.mjs",
    "lint": "node --check assets/js/script.js && node scripts/validate.mjs",
    "docker:build": "docker build -t ak-accounting .",
    "docker:run": "docker run --rm -p 8080:80 ak-accounting",
    "docker:compose": "docker compose up --build"
  },
  "keywords": ["accounting", "mali-musavirlik", "github-pages", "accessible", "template"],
  "author": "A Koc <ak@ak-pro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ak-hosting/ak-accounting.git"
  },
  "bugs": {
    "url": "https://github.com/ak-hosting/ak-accounting/issues"
  },
  "homepage": "https://ak-hosting.github.io/ak-accounting/",
  "engines": {
    "node": ">=18.0.0"
  }
}
